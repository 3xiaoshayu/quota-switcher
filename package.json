{
  "name": "codex-account-manager",
  "version": "2.0.8",
  "private": true,
  "description": "Quota Switcher for Codex, Cursor, and Antigravity accounts on Windows. Quotas and switching stay on this PC.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run renderer:build && electron .",
    "dev": "npm run renderer:build && electron . --dev",
    "renderer:build": "vite build --config vite.renderer.config.ts",
    "renderer:check": "tsc --noEmit -p tsconfig.renderer.json",
    "installer:art": "node scripts/make-installer-art.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check:security": "node scripts/check-security-config.js",
    "check:docs": "node scripts/check-doc-links.js",
    "audit:ui": "node scripts/audit-ui-contract.js",
    "release:check": "node scripts/verify-release.js",
    "release:clean": "node scripts/clean-release-artifacts.js",
    "release:artifacts": "node scripts/check-release-artifacts.js",
    "check": "npm run renderer:check && npm run check:syntax && npm run check:security && npm run check:docs && npm run audit:ui && npm run release:check",
    "test:engine": "node --test test/*.test.js",
    "test": "npm run test:engine && npm run check",
    "build": "npm run build:windows",
    "build:dir": "npm run renderer:build && electron-builder --dir --win --x64",
    "build:windows": "npm run release:clean && npm run renderer:build && npm run release:check && electron-builder --win nsis zip --x64 --publish never && npm run release:artifacts",
    "build:nsis": "npm run renderer:build && electron-builder --win nsis --x64 --publish never"
  },
  "author": "WangJin",
  "license": "MIT",
  "homepage": "https://github.com/3xiaoshayu/quota-switcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3xiaoshayu/quota-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/3xiaoshayu/quota-switcher/issues"
  },
  "keywords": [
    "quota-switcher",
    "codex",
    "cursor",
    "openai",
    "account-manager",
    "account-switcher",
    "quota-tracker",
    "antigravity",
    "electron",
    "windows",
    "local-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.2",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.42.2",
    "playwright-core": "^1.55.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "proxy-agent": "^6.5.0",
    "proxy-from-env": "^1.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "ip-address": "10.5.0",
    "postcss": "8.5.26",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "tar": "7.5.22",
    "@electron/get": {
      "undici": "7.29.0"
    },
    "node-gyp": {
      "undici": "6.28.0"
    },
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9"
  }
}
