{
  "name": "codex-account-manager",
  "version": "0.1.0-beta.1",
  "description": "Windows desktop account, quota, and token manager for Codex",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "audit:ui": "node scripts/audit-ui-contract.js",
    "release:check": "node scripts/verify-release.js",
    "build": "npm run build:windows",
    "build:dir": "electron-builder --dir --win --x64",
    "build:windows": "npm run release:check && electron-builder --win nsis zip --x64 --publish never",
    "build:nsis": "electron-builder --win nsis --x64 --publish never"
  },
  "author": "WangJin",
  "license": "MIT",
  "homepage": "https://github.com/3xiaoshayu/codex-account-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3xiaoshayu/codex-account-manager.git"
  },
  "bugs": {
    "url": "https://github.com/3xiaoshayu/codex-account-manager/issues"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "lucide": "^1.22.0"
  }
}
